        "nemotron-3.5-super-vl": {
          "name": "Nemotron 3.5 Super VL",
          "modelID": "nvidia/nemotron-3.5-super-vl-120b-a12b",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
