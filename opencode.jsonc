{
  "$schema": "https://opencode.ai/config.json",
  "username": "DrewR",
  "default_agent": "plan",
  "model": "strata/strata",
  "share": "disabled",
  "agents": {
    "build": {
      "system": "Talk like a normal person. Short sentences. No explaining flags or options unless asked. No moralizing, no summaries. Answer the exact question and stop."
    },
    "plan": {
      "system": "Talk like a normal person. Short sentences. No explaining flags or options unless asked. No moralizing, no summaries. Answer the exact question and stop."
    }
  },
  "timezone": "America/New_York",
  "policies": [
    {
      "action": "integration.use",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "mcp.use",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill.use",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "plugin.use",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch.use",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "subagent:*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:rm*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:pip *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:pipx *",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:gh *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git pull*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:git checkout*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:git stage*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:git add*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:git commit*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:killall plasmashell*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:killall *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:systemctl --user restart plasma-kwin_wayland.service",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:pkexec --user root systemctl restart plasma-kwin_wayland.service",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:sudo systemctl restart plasma-kwin_wayland.service",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:pkexec --user root systemctl restart plasmalogin.service",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:sudo systemctl restart plasmalogin.service",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:systemctl --user restart plasmalogin.service",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:*queryWindowInfo*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:*getWindowInfo*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:*MoveMouseToFocus*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*/.sshd/*",
      "effect": "deny"
    }
  ],
  "snapshots": true,
  "formatter": true,
  "lsp": true,
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 3840,
      "max_height": 2160,
      "max_base64_bytes": 9007199254740991
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 25600
  },
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "opencode_list_mcp_resources",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "opencode_read_mcp_resources",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "experimental_image_generation",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "/home/slippy/repos/worktrees/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "glob",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git clone *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git pull *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "spectacle *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gdbus call *queryWindowInfo*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gdbus call *getWindowInfo*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "qdbus * queryWindowInfo",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "qdbus * getWindowInfo",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "busctl call * queryWindowInfo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "busctl call * getWindowInfo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "systemctl * restart plasma-*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "systemctl * stop plasma*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "killall*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kill plasmashell",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "killall plasmashell",
      "effect": "deny"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lsp",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "task",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "browser",
      "effect": "allow"
    },
    {
      "action": "browser",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "disabled": false,
        "codemode": true,
        "command": [
          "/home/slippy/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        },
        "cwd": "/home/slippy",
        "pool": true
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
        "disabled": false,
        "codemode": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "codemode": true,
        "disabled": false,
        "headers": {
          "Authorization": "{file:~/.config/opencode-secrets/context7-auth}"
        }
      },
      "plannotator-inbox": {
        "type": "local",
        "command": [
          "/home/slippy/.local/bin/plannotator",
          "inbox",
          "mcp"
        ],
        "disabled": false,
        "codemode": true
      }
    }
  },
  "compaction": {
    "auto": true
  },
  "websearch": {
    "provider": "random"
  },
  "plugins": [
    "opencode-wakatime@latest",
    "opencode-skills-tui@latest",
    "@plannotator/opencode"
  ],
  "experimental": {
    "todo": true,
    "media_blob": true,
    "image_generate": true,
    "artifacts": true,
    "subagent_depth": 1
  },
  "warming": false,
  "providers": {
    "amd": {
      "settings": {
        "baseURL": "https://api.tokenlab.amd.com/v1",
        "apiKey": "{file:~/.config/opencode-secrets/amd-api-key}"
