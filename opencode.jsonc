        "nemotron-3-nano-omni": {
          "name": "Nemotron 3 Nano Omni",
          "modelID": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video", "audio"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    },
    "BasteenHackaton": {
      "name": "basteenHackathon",
      "settings": {
        "baseURL": "https://inference.baseten.co/v1",
        "apiKey": "{file:~/.config/opencode-secrets/baseten-api-key}"
      },
      "models": {
        "meta-models/muse-spark-open-1026": {
          "modelID": "meta-models/muse-spark-open-1026",
          "name": "meta-models/muse-spark-open-1026"
        }
      }
    },
    "strata": {
      "name": "Strata (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{file:~/.config/opencode-secrets/strata-api-key}"
      },
      "models": {
        "strata": {
          "name": "Qwen3.8-Flash-Next Coder (local)",
          "type": "chat",
          "limit": {
            "context": 262144,
            "input": 258048,
            "output": 32768
          },
          // reasoning controls, spelled out per the V2 docs so this file is a reference.
          // effort: what variants exist; toggle: adds the generated `none` variant (verified:
          //   request body carries "reasoning_effort": "none"). `budget` is NOT set here - the docs
          //   ignore it while `effort` is set, so the per-variant hard cap lives in variants[].body.
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high"
              ],
              "toggle": true
            }
          },
          // compatibility: spelled out even where it matches the package default, so the
          //   behavior is visible rather than implicit. reasoningField: Strata streams thinking
          //   as `reasoning_content` (serve/server.py:6098) - same value OpenCode falls back to,
          //   now stated. cacheFormat: this endpoint takes no Anthropic-style cache_control
          //   markers; "none" keeps the request byte-identical to today's wire format.
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "low",
              // effort sentence (prose, per base.py:79) + the hard cap that actually bounds thinking
              "settings": {
                "reasoningEffort": "low"
              },
              "body": {
                "reasoning_budget_tokens": 2048
              }
            },
            // `none` must be spelled out: toggle does NOT generate it for the
            //   openai-compatible package (verified 2026-11-20: removing it gives
            //   "Variant unavailable ... : none" even with toggle: true)
            {
              "id": "none",
              "body": {
                "reasoning_effort": "none"
              }
            },
            // your pre-existing 4096 cap: thinking bounded without an effort sentence
            {
              "id": "budget",
              "body": {
                "reasoning_budget_tokens": 4096
              }
            }
          ]
        }
      }
    },
    "ignis-server": {
      "name": "ignis-server",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
